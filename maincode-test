/* страница списка */
/* === МОБИЛЬНЫЙ ВИД: РАЗДЕЛЕНИЕ THEAD И TBODY === */
@media screen and (max-width: 767px) {
/* таблица - блочный контейнер */
  .p-user_rates-index .list-lines.b-table {
    display: block;
  }
/* заголовки остаются таблицей со своими ширинами */
  .p-user_rates-index .list-lines thead {
    display: table;
    width: 100%;
  }
/* блок tbody, независимый от thead */
  .p-user_rates-index .list-lines tbody {
    display: block;
  }

/* строки тайтлов - независимый grid */
  .p-user_rates-index .list-lines tbody tr.user_rate.selectable {
    display: grid;
    grid-template-columns: 15px minmax(0, 1fr) minmax(0, 1fr) 20px 115px;
    grid-template-rows: auto auto auto;
    gap: 3px 4px;
    padding: 4px 2px;
    align-items: start;
  }
  
/* форма редактирования - блок, не grid */
  .p-user_rates-index .list-lines tbody tr.edit-form {
    display: block;
  }
  
/* убираем бокс, дети становятся элементами grid */
  .p-user_rates-index .list-lines tbody tr.user_rate.selectable .name {
    display: contents;
  }
  
/* номер */
  .p-user_rates-index .list-lines tbody tr.user_rate.selectable .index {
    grid-column: 1;
    grid-row: 1;
    text-align: left;
  }
  
/* название */
  .p-user_rates-index .list-lines tbody tr.user_rate.selectable .name a {
    grid-column: 2 / 4;
    grid-row: 1 / 2;
    min-width: 0;
    padding-left: 5px;
  }
  
/* оценка */
  .p-user_rates-index .list-lines tbody tr.user_rate.selectable .num:nth-child(3) {
    grid-column: 4;
    grid-row: 1;
    text-align: left;
  }
  
/* эпизоды и тип в одном блоке */
  .p-user_rates-index .list-lines tbody tr.user_rate.selectable .num:nth-child(4) {
    grid-column: 5;
    grid-row: 1;
    justify-self: start;
    text-align: left;
  }
  .p-user_rates-index .list-lines tbody tr.user_rate.selectable .num:nth-child(5) {
    grid-column: 5;
    grid-row: 1;
    justify-self: end;
    text-align: right;
  }
  
/* бейджик */
  .p-user_rates-index .list-lines tbody tr.user_rate.selectable .name .rewatches,
  .p-user_rates-index .list-lines tbody tr.user_rate.selectable .name .anons,
  .p-user_rates-index .list-lines tbody tr.user_rate.selectable .name .ongoing {
    grid-column: 2 / 4;
    grid-row: 2;
    justify-self: start;
  }
  
/* комментарий */
  .p-user_rates-index .list-lines tbody tr.user_rate.selectable .name .rate-text {
    grid-column: 2 / 6;
    grid-row: 3;
    width: 100%;
    padding: 0 15px 0 8px;
  }
}




